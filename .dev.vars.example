# Copy to .dev.vars for `npm run dev`. Never commit .dev.vars.
SENDGRID_API_KEY=SG.your-key-here
FROM_EMAIL=alerts@example.com
# At least 32 random characters. Generate one with: openssl rand -base64 48
TOKEN_SECRET=replace-me-with-a-long-random-string
# Optional: push alerts. Generate both keys with `npm run vapid:generate`;
# the public one goes in wrangler.toml as VAPID_PUBLIC_KEY.
VAPID_PRIVATE_KEY=
